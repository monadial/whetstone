+++ b/src/cache.rs
@@ -73,7 +73,7 @@ impl TenantCache {
 #[cfg(test)]
 mod tests {
     use super::*;
-    use crate::payment::ChargeOutcome;
+    use crate::payment::ProviderOutcome;
 
     #[test]
     fn a_busy_tenant_cannot_evict_another_tenants_payments() {
@@ -96,7 +96,7 @@ mod tests {
         let cache = TenantCache::new(2);
         let stale = Payment::sample("acme", "order");
         let mut fresh = stale.clone();
-        fresh.record(ChargeOutcome::Unknown).unwrap();
+        fresh.record(ProviderOutcome::Unknown).unwrap();
 
         cache.update(&fresh);
         cache.fill(&stale);
