    area: Rect { x: 0, y: 0, width: 120, height: 32 },
    content: [
        "                                                                                                                        ",
        "  Settings                                                                                                              ",
        "  No config found at ~/.config/whetstone/config.toml, so these are the defaults.                                        ",
