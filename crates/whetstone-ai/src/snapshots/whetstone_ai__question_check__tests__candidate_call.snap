      "stem": "Why does the retry in `charge_with_retry` now reuse `original.key` instead of making a new `OperationKey`?",
      "options": {
        "A": {
          "text": "So that the provider treats the retry as the same charge, and a charge that went through before the timeout isn't made twice.",
          "rationale": "Correct: `Client::charge` says the provider charges at most once per key and returns the first charge's receipt for a key it has seen."
        },
        "B": {
          "text": "So that the retry skips the provider's checks on the card and completes faster than the first attempt.",
          "rationale": "Wrong: nothing in the evidence says a repeated key skips checks or speeds anything up."
        },
        "C": {
          "text": "So that the provider rejects the retry if the first attempt failed, and the caller sees the original timeout.",
          "rationale": "Wrong: for a key it has seen, the provider returns the first charge's receipt; a timeout is retried, not passed on."
        }
      },
      "answer_key": "A",
      "why_it_matters": "A timeout doesn't say whether a charge went through, so a retry must never be able to charge the customer twice.",
      "rubric": {
        "criterion_1": {
          "statement": "Explains that a timed-out charge may still have gone through.",
          "met": "Says the first charge might have succeeded even though the client saw a timeout.",
          "not_met": "Treats the timeout as proof that nothing was charged, or doesn't consider it."
        },
        "criterion_2": {
          "statement": "Connects reusing the key to the provider charging at most once per key.",
          "met": "Says the provider recognises the repeated key and returns the first charge instead of charging again.",
          "not_met": "Doesn't say how the reused key prevents a second charge."
        }
      },
