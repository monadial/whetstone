          "path": "src/payments/retry.rs",
          "diff": "diff --git a/src/payments/retry.rs b/src/payments/retry.rs\n--- a/src/payments/retry.rs\n+++ b/src/payments/retry.rs\n@@ -1,9 +1,10 @@\n pub async fn charge_with_retry(client: &Client, original: &Charge) -> Result<Receipt, Error> {\n     match client.charge(original.amount, original.key.clone()).await {\n         Err(Error::Timeout) => {\n-            let key = OperationKey::new();\n+            // The provider treats a repeated key as the same charge.\n+            let key = original.key.clone();\n             client.charge(original.amount, key).await\n         }\n         result => result,\n     }\n }\n",
          "content_after_change": "1: pub async fn charge_with_retry(client: &Client, original: &Charge) -> Result<Receipt, Error> {\n2:     match client.charge(original.amount, original.key.clone()).await {\n3:         Err(Error::Timeout) => {\n4:             // The provider treats a repeated key as the same charge.\n5:             let key = original.key.clone();\n6:             client.charge(original.amount, key).await\n7:         }\n8:         result => result,\n9:     }\n10: }"
